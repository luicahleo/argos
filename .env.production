# ARGOS Production Environment Variables
# VPS Production Configuration

# Flask Configuration
FLASK_ENV=production
DEBUG=False

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# ICARUS.API Integration (Docker Network)
ICARUS_API_URL=http://icarus-api:5090
# Debe coincidir con ArgosSettings:ServiceKey (ArgosSettings__ServiceKey) en ICARUS.API
ICARUS_SERVICE_KEY=

# DeepFace Model Configuration
MODEL_NAME=ArcFace
DISTANCE_METRIC=cosine
DETECTOR_BACKEND=opencv
VERIFICATION_THRESHOLD=0.68

# Gunicorn Workers
WORKERS=2

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/argos.log

# Timezone
TZ=America/La_Paz
